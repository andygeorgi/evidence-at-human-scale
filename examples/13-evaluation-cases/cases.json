{
  "synthetic": true,
  "note": "Each case copies the example set in memory, applies the mutation and requires exactly the listed codes. These are deterministic functional checks on synthetic data; they are not the EV01-EV12 evaluation programme, which has not been run.",
  "cases": [
    {
      "case_id": "CASE-SCH-01",
      "family": "schema",
      "title": "A required group is removed",
      "why": "Every contract group is required; a record without a lifecycle is not an evidence record.",
      "expect": [
        "SCH002"
      ],
      "mutations": [
        {
          "target": "C02 GR-5521 v1",
          "ops": [
            {
              "op": "remove",
              "path": "/lifecycle"
            }
          ]
        }
      ]
    },
    {
      "case_id": "CASE-SCH-02",
      "family": "schema",
      "title": "A timestamp without a time zone",
      "why": "Timestamps must be complete RFC 3339 date-times; a bare local time is ambiguous.",
      "expect": [
        "SCH002"
      ],
      "mutations": [
        {
          "target": "C02 INV-2026-0417 v1",
          "ops": [
            {
              "op": "replace",
              "path": "/times/ingestion",
              "value": "2026-11-23T07:31:00"
            }
          ]
        }
      ]
    },
    {
      "case_id": "CASE-SCH-03",
      "family": "schema",
      "title": "An outcome state outside the vocabulary",
      "why": "A receipt has five outcome states; 'probably done' is not one of them.",
      "expect": [
        "SCH002"
      ],
      "mutations": [
        {
          "target": "C07 RCP-REL-0417-B v1",
          "ops": [
            {
              "op": "replace",
